# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== 图谱记忆配置 =====
# 生产默认使用本地 Graphiti。Zep Cloud 仅作为回退 provider。
MEMORY_PROVIDER=graphiti
GRAPHITI_BASE_URL=http://127.0.0.1:8010
GRAPHITI_NEO4J_URI=bolt://127.0.0.1:17687
GRAPHITI_NEO4J_USER=neo4j
GRAPHITI_NEO4J_PASSWORD=your_local_neo4j_password_here
GRAPHITI_LLM_BASE_URL=http://127.0.0.1:4000/v1
GRAPHITI_LLM_MODEL_NAME=gpt-4.1-mini
GRAPHITI_SMALL_MODEL_NAME=gpt-4.1-nano
GRAPHITI_EMBEDDING_BASE_URL=http://127.0.0.1:4000/v1
GRAPHITI_EMBEDDING_MODEL=text-embedding-3-small
GRAPHITI_EMBEDDING_DIM=1024
GRAPHITI_EPISODE_TIMEOUT_SECONDS=90

# ===== ZEP记忆图谱配置（回退） =====
# MEMORY_PROVIDER=zep 时需要配置。
ZEP_API_KEY=your_zep_api_key_here

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here
